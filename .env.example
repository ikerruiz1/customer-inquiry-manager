# ==============================================================================
# Customer Inquiry Manager - Environment Configuration Template
# Copy this file to '.env' and customize for your local or production environment.
# Note: In production, secrets are managed dynamically via AWS Secrets Manager & AWS KMS.
# ==============================================================================

# Application Environment (dev | staging | prod)
ENVIRONMENT=dev

# Database Connection
# Local Development: SQLite on-disk database (sqlite+aiosqlite:///customer_inquiries.db)
# Production AWS: PostgreSQL 16 via asyncpg (postgresql+asyncpg://user:pass@rds-endpoint:5432/customer_inquiries)
DATABASE_URL=sqlite+aiosqlite:///customer_inquiries.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Initial Support Operator / Administrator Credentials (Decoupled from code)
# Auto-generated or configured during bootstrap. Never commit production passwords to git!
INITIAL_OPERATOR_NAME=Cloud Administrator
INITIAL_OPERATOR_EMAIL=admin@company.internal
INITIAL_OPERATOR_PASSWORD=

# AWS Infrastructure & Region
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Amazon Cognito Identity & RBAC (Zero-Trust RFC 6238 Software Token MFA)
# Automatically populated by scripts/deploy-infra.ps1 during cloud deployment.
# Leave blank for local development (uses local auth service with RFC 6238 TOTP).
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_URL=

# Amazon Bedrock Foundation Models (Verified Live 2026 Fleet)
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# When true, executes deterministic offline triage heuristics (zero AWS cost).
# Defaults to true in 'dev' environment, false in 'prod'.
BEDROCK_OFFLINE_MODE=true

# Amazon S3 Multi-Tier Storage
S3_ATTACHMENTS_BUCKET=customer-inquiry-attachments-dev
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Amazon SQS FIFO Decoupled Ingestion Buffer & Dead-Letter Queue
SQS_INQUIRIES_QUEUE_URL=
SQS_INQUIRIES_DLQ_URL=
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_BATCH_SIZE=10
SQS_CONSUMER_POLL_INTERVAL_SECONDS=1.0

# Amazon SNS Event Notification Topics
SNS_ALERTS_TOPIC_ARN=
SNS_CUSTOMER_RECEIPTS_TOPIC_ARN=
